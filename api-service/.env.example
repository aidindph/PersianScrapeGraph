# ─────────────────────────────────────────────────────────────────────────────
#  PersianScrapeGraph — api-service · نمونهٔ متغیرهای محیطی
#  کپی کنید:  cp api-service/.env.example api-service/.env
# ─────────────────────────────────────────────────────────────────────────────

# مدل پیش‌فرض به شکل provider/model
# مثال‌ها: ollama/llama3.2 · openai/gpt-4o-mini · deepseek/deepseek-chat
SGAI_MODEL=ollama/llama3.2

# نشانی سرویس Ollama (فقط برای مدل‌های ollama/)
#  - اجرای محلی:  http://localhost:11434
#  - کنار docker-compose این ریپو:  http://ollama:11434
SGAI_OLLAMA_URL=http://localhost:11434

# کلید API مدل‌های ابری (اختیاری — برای OpenAI/DeepSeek و مشابه‌ها)
# SGAI_API_KEY=
