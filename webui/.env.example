# ─────────────────────────────────────────────────────────────────────────────
#  PersianScrapeGraph — webui · نمونهٔ متغیرهای محیطی
#  این فایل را به «.env» کپی کنید و مقادیر را تنظیم کنید:
#      cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# آدرس دیتابیس SQLite برای توسعهٔ محلی.
# مسیر نسبت به پوشهٔ prisma/ سنجیده می‌شود → یعنی فایل در webui/db/custom.db
DATABASE_URL="file:../db/custom.db"

# نشانی سرویس موتور استخراج واقعی (api-service).
# اگر تنظیم شود، همهٔ استخراج‌ها به گراف کامل ScrapeGraphAI در آن سرویس
# ارسال می‌شوند؛ در غیر این صورت حالت دموی سبک استفاده می‌شود.
# مثال‌ها:
#   SCRAPE_API_URL="http://localhost:8000"                 (اجرای محلی)
#   SCRAPE_API_URL="https://your-engine.up.railway.app"    (استقرار ابری)
# SCRAPE_API_URL=""
